{
  "name": "fleek",
  "version": "0.1.0",
  "description": "A live mirror for clothes you haven't bought yet.",
  "main": "./out/main/index.js",
  "author": "Fleek",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run lint && npm run typecheck && npm run test && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/check-grid.mjs",
    "package": "npm run build && node scripts/make-icon.mjs && electron-builder --win --config electron-builder.yml",
    "fonts": "node scripts/fetch-fonts.mjs",
    "dev:web": "vite",
    "build:web": "npm run assets && npm run lint && npm run typecheck:web && npm run test && vite build",
    "preview:web": "vite preview",
    "models": "node scripts/fetch-models.mjs",
    "assets": "npm run fonts && npm run models"
  },
  "dependencies": {
    "@decartai/sdk": "^0.1.22",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@phosphor-icons/react": "^2.1.7",
    "motion": "^11.15.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
